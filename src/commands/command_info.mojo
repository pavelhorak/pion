def cmd_keyspecs(tp: Pointer[UInt8, MutUntrackedOrigin], tl: Int) -> StaticString:
    """The command's key specs, encoded (see tools/gen_command_info.py)."""
    if _eq(tp, tl, "append"): return "I1R0,1,0:RW,insert"
