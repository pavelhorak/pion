struct InfoSpan(Copyable, Movable, ImplicitlyCopyable):
    var off2: Int
    var len2: Int
    var off3: Int
    var len3: Int

    def __init__(out self, off2: Int, len2: Int, off3: Int, len3: Int):
        self.off2 = off2
        self.len2 = len2
        self.off3 = off3
        self.len3 = len3


def cmdinfo_span(tp: Pointer[UInt8, MutUntrackedOrigin], tl: Int) -> InfoSpan:
    """Where the command's Redis COMMAND INFO entry is in CMDINFO2/3; len2 0
    for a Pion-only command."""
    if _eq(tp, tl, "acl"): return InfoSpan(0, 1743, 0, 1743)
