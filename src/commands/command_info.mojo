    if _eq(tp, tl, "zremrangebylex"): return True
    if _eq(tp, tl, "zremrangebyrank"): return True
    if _eq(tp, tl, "zremrangebyscore"): return True
    if _eq(tp, tl, "zunionstore"): return True
    if _eq(tp, tl, "function"):
        return _eq(sp, sl, "delete") or _eq(sp, sl, "flush") or _eq(sp, sl, "load") or _eq(sp, sl, "restore")
    if _eq(tp, tl, "xgroup"):
        return _eq(sp, sl, "create") or _eq(sp, sl, "createconsumer") or _eq(sp, sl, "delconsumer") or _eq(sp, sl, "destroy") or _eq(sp, sl, "setid")
    return False


def cmd_is_container(tp: Pointer[UInt8, MutUntrackedOrigin], tl: Int) -> Bool:
    """Does the command have subcommands (CLIENT, CONFIG, ...)? ACL LOG names
    those as `command|subcommand`, as Redis does."""
    if _eq(tp, tl, "acl"): return True
    if _eq(tp, tl, "client"): return True
    if _eq(tp, tl, "cluster"): return True
    if _eq(tp, tl, "command"): return True
    if _eq(tp, tl, "config"): return True
    if _eq(tp, tl, "function"): return True
    if _eq(tp, tl, "latency"): return True
    if _eq(tp, tl, "memory"): return True
    if _eq(tp, tl, "module"): return True
    if _eq(tp, tl, "object"): return True
    if _eq(tp, tl, "pubsub"): return True
    if _eq(tp, tl, "script"): return True
    if _eq(tp, tl, "slowlog"): return True
    if _eq(tp, tl, "xgroup"): return True
    if _eq(tp, tl, "xinfo"): return True
    return False


