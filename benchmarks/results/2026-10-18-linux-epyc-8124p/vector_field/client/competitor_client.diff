     def ready_to_search(self) -> bool:
         """Check if the database is ready to search."""
 
+    def _backlog(self) -> tuple[bool, str]:
+        """(done, description) for the server's own report of the vector index build."""
+        info = _info_dict(self.conn.execute_command("FT.INFO", INDEX_NAME))
+        if WAIT == "redisearch":
+            s = self.conn.info("search")  # redis-py parses INFO into a dict
+            keys =("search_tiered_index_frontend_buffer_size", "search_workers_low_priority_pending_jobs",
+                    "search_workers_high_priority_pending_jobs", "search_active_worker_threads")
+            missing = [k for k in keys if k not in s]
+            if missing:  # a server without these fields can never report done: fail, never wait
+                msg = f"competitor optimize(): INFO search lacks {missing}"
+                raise RuntimeError(msg)
+            vals = {k: str(s[k]) for k in keys}
+            idle = (_s(info.get("indexing", "1")) == "0" and _s(info.get("percent_indexed", "0")) in ("1", "1.0")
+                    and all(vals[k] == "0" for k in keys[1:]))
+            fb = vals[keys[0]]
+            desc = f"indexing={_s(info.get('indexing'))} percent={_s(info.get('percent_indexed'))} {vals}"
+            if idle and fb != "0":
+                # SVS-VAMANA keeps vectors below its flush threshold in the flat frontend buffer,
+                # which searches scan; with no job pending and no worker active nothing moves
+                # them (box 2026-10-18: 562 of 50,000). Done once that has held STEADY_S.
+                now = time.perf_counter()
+                if getattr(self, "_steady_fb", None) != fb:
+                    self._steady_fb, self._steady_t = fb, now
+                held = now - self._steady_t
+                return held >= STEADY_S, desc + f" idle, frontend buffer steady {held:.1f}s"
+            self._steady_fb = None
+            return idle and fb == "0", desc
+        if WAIT == "valkey":
+            # valkey-search FT.INFO: state ready|backfill_*, backfill_in_progress, mutation_queue_size
+            # plus INFO search: search_writer_queue_size, search_background_indexing_status
+            s = self.conn.info("search")
+            missing = [k for k in ("state", "mutation_queue_size", "backfill_in_progress") if k not in info]
+            missing += [k for k in ("search_writer_queue_size", "search_background_indexing_status") if k not in s]
+            if missing:
+                msg = f"competitor optimize(): valkey-search reports no {missing}"
+                raise RuntimeError(msg)
+            state = _s(info["state"])
+            q = _s(info["mutation_queue_size"])
+            bip = _s(info["backfill_in_progress"])
+            wq = str(s["search_writer_queue_size"])
+            bg = str(s["search_background_indexing_status"])
+            done = state.lower() == "ready" and q == "0" and bip == "0" and wq == "0" and bg == "NO_ACTIVITY"
+            return done, (f"state={state} mutation_queue_size={q} backfill_in_progress={bip} "
+                          f"writer_queue={wq} background={bg} num_docs={_s(info.get('num_docs'))}")
+        return True, "no wait"
+
