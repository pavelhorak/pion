+# ---------------------------------------------------------------------------
+# Pion vector field session (2026-10), competitor install. Every knob is an
+# environment variable, and with none set this file sends exactly what stock
+# VectorDBBench 1.0.22 sends: HNSW, FLOAT32, EF_RUNTIME, SORTBY score.
+# The diff against redis.py.stock-1.0.22 is the whole change.
+#
+#   VDBB_REDIS_ALGO          HNSW (default) | SVS-VAMANA
+#   VDBB_REDIS_TYPE          FLOAT32 (default) | FLOAT16. Inserted AND query
+#                            vectors are encoded in this type: a FLOAT16 index
+#                            rejects FLOAT32 blobs.
+#   VDBB_REDIS_COMPRESSION   "" (default) | LVQ8 | ... (SVS-VAMANA only)
+#   VDBB_REDIS_INDEX_EXTRA   extra index attributes, "NAME VALUE NAME VALUE"
+#   VDBB_REDIS_SEARCH_PARAM  EF_RUNTIME (default) | SEARCH_WINDOW_SIZE. The
+#                            harness's --ef-runtime value is sent under this
+#                            name (SVS-VAMANA rejects EF_RUNTIME).
+#   VDBB_REDIS_SORTBY        1 (default) | 0
+#   VDBB_REDIS_WAIT          "" (default: optimize() is a no-op, as stock) |
+#                            redisearch | valkey: optimize() polls until the
+#                            server reports the vector index fully built, so
+#                            searches never run against a backlog and the
+#                            build is counted in load_duration as Pion's
+#                            FT.OPTIMIZE is.
+#   VDBB_REDIS_WAIT_TIMEOUT  seconds, default 7200
+# ---------------------------------------------------------------------------
+ALGO = os.environ.get("VDBB_REDIS_ALGO", "HNSW").upper()
+VTYPE = os.environ.get("VDBB_REDIS_TYPE", "FLOAT32").upper()
+COMPRESSION = os.environ.get("VDBB_REDIS_COMPRESSION", "")
+INDEX_EXTRA = os.environ.get("VDBB_REDIS_INDEX_EXTRA", "").split()
+SEARCH_PARAM = os.environ.get("VDBB_REDIS_SEARCH_PARAM", "EF_RUNTIME").upper()
+SORTBY = os.environ.get("VDBB_REDIS_SORTBY", "1") == "1"
+WAIT = os.environ.get("VDBB_REDIS_WAIT", "").lower()
+WAIT_TIMEOUT = float(os.environ.get("VDBB_REDIS_WAIT_TIMEOUT", "7200"))
+STEADY_S = float(os.environ.get("VDBB_REDIS_WAIT_STEADY", "10"))
+NP_TYPE = {"FLOAT32": np.float32, "FLOAT16": np.float16, "FLOAT64": np.float64}[VTYPE]
+STOCK_INDEX = ALGO == "HNSW" and VTYPE == "FLOAT32" and not COMPRESSION and not INDEX_EXTRA
 
+
+def _info_dict(reply) -> dict:
+    out = {}
+    for k, v in zip(reply[::2], reply[1::2]):
+        out[k.decode() if isinstance(k, bytes) else str(k)] = v
+    return out
+
+
+def _s(v) -> str:
+    return v.decode() if isinstance(v, bytes) else str(v)
+
